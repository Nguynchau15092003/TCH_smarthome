<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Smarthomevoice"
        tools:targetApi="31">

        <!-- Đặt OnboardingActivity làm launcher -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Xóa LoginActivity vì không dùng nữa -->
        <!-- <activity
            android:name=".LoginActivity"
            android:exported="true" /> -->

        <!-- MainActivity: Màn hình chính sau Onboarding -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Smarthomevoice" />

        <!-- TakeNoteActivity: mở từ chức năng Take Note -->
        <activity
            android:name=".TakeNoteFragment"
            android:exported="true" />

    </application>

</manifest>
