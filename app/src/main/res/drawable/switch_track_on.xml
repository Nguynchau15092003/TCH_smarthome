<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Kích thước track (chiều rộng, cao tuỳ ý) -->
    <size
        android:width="60dp"
        android:height="30dp" />

    <!-- Bo góc để tạo hình “viên thuốc” -->
    <corners android:radius="15dp" />

    <!-- Màu nền khi ON (xanh lá, tuỳ chỉnh) -->
    <solid android:color="@color/green_on" />

</shape>
