<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/onboarding_gradient_background">

    <ImageView
        android:id="@+id/imageOnboarding"
        android:layout_width="293dp"
        android:layout_height="325dp"
        android:layout_gravity="center"
        android:contentDescription="@string/onboarding_image_desc"
        android:scaleType="centerInside"
        android:src="@drawable/onboarding1" />

    <LinearLayout
        android:id="@+id/textContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleOnboarding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:fontFamily="@font/inter"
            android:gravity="start"
            android:text="Control all devices"
            android:textColor="#333333"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/descriptionOnboarding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="12dp"
            android:gravity="start"
            android:text="Easily access and manage the smart devices in your home."
            android:textColor="#777777"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>